{
    "name": "webhatchery/isitdoneyet-backend",
    "description": "PHP backend for Is It Done Yet recursive project management",
    "type": "project",
    "require": {
        "php": "^8.1",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.4",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }    },
    "scripts": {
        "start": [
            "@putenv COMPOSER_PROCESS_TIMEOUT=0",
            "php -S localhost:3001 -t public/"
        ],
        "test": "../../../vendor/bin/phpunit --configuration phpunit.xml",
        "cs-check": "../../../vendor/bin/phpcs --standard=PSR12 src/ tests/",
        "cs-fix": "../../../vendor/bin/phpcbf --standard=PSR12 src/ tests/"
    },
    "config": {
        "process-timeout": 0
    }
}
